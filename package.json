{
  "name": "vans-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "eslint .",
    "test:rede-parser": "tsx scripts/test-rede-parser.ts",
    "test:commission": "tsx --test scripts/commission-calculator.test.ts",
    "firestore:import:dry": "tsx scripts/import-firestore-backup.ts",
    "firestore:import:apply": "tsx scripts/import-firestore-backup.ts --apply",
    "auth:migrate:dry": "tsx scripts/migrate-firebase-auth.ts",
    "auth:migrate:apply": "tsx scripts/migrate-firebase-auth.ts --apply",
    "test:auth-migration": "tsx --test scripts/user-uid-migration.test.ts",
    "test:auth-session": "tsx --test scripts/auth-session.test.ts",
    "test:auth-flow": "tsx --test scripts/auth-session.test.ts scripts/authentication-flow.test.ts",
    "test:permissions-matrix": "tsx --test scripts/permissions-matrix.test.ts",
    "test:firestore:user-profile": "firebase emulators:exec --only firestore --project vans-task-8-rules \"tsx --test scripts/firestore-user-profile-rules.test.ts\"",
    "test:firestore:collections": "firebase emulators:exec --only firestore --project vans-task-9-rules \"tsx --test scripts/firestore-sensitive-collections-rules.test.ts\"",
    "test:api-authorization": "tsx --test scripts/server-authorization.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jimp": "^1.6.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "motion": "^11.13.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.0"
  }
}
