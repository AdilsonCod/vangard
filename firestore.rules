rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'ADMIN') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().keys().hasAny(['role']) && getUserData().role == 'ADMIN')
      );
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().keys().hasAny(['role']) && getUserData().role == role)
      );
    }

    function canManageFinance() {
      return isAdmin() || hasRole('FINANCIAL');
    }

    function canManageMarketing() {
      return isAdmin() || hasRole('MARKETING');
    }

    function canManageCommunication() {
      return canManageMarketing() || hasRole('RECEPTION');
    }

    function isUserInUnit(unitId) {
      return isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         ((getUserData().keys().hasAny(['unit']) && getUserData().unit == unitId) ||
          (getUserData().keys().hasAny(['unitId']) && getUserData().unitId == unitId)))
      );
    }

    // Coleções de Sistema
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'notes', 'barberNotes'])
      );
    }

    match /authUsers/{authId} {
      allow read, write: if isAdmin();
    }

    match /systemUnits/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /catalog/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /subcategories/{subId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /financialCategories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /suppliers/{supId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /finClassifications/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /finSubclassifications/{subId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /targets/{targetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Coleções Operacionais (com isolamento por unidade)
    match /entries/{entryId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || isUserInUnit(resource.data.unitId));
      allow create, update: if isAuthenticated() && (isAdmin() || isUserInUnit(request.resource.data.unitId));
      allow delete: if isAdmin();
    }

    match /gdvEntries/{gdvId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || isUserInUnit(resource.data.unitId));
      allow create, update: if isAuthenticated() && (isAdmin() || isUserInUnit(request.resource.data.unitId));
      allow delete: if isAdmin();
    }

    match /gdvSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /monthlyUnitStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /monthlyBarberStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /transactions/{transId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || isUserInUnit(resource.data.unitId));
      allow create, update: if isAuthenticated() && (isAdmin() || isUserInUnit(request.resource.data.unitId));
      allow delete: if isAdmin();
    }

    match /cashClosings/{closingId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || isUserInUnit(resource.data.unitId));
      allow create, update: if isAuthenticated() && (isAdmin() || isUserInUnit(request.resource.data.unitId));
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || isUserInUnit(resource.data.unitId));
      allow create, update: if isAuthenticated() && (isAdmin() || isUserInUnit(request.resource.data.unitId));
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /appSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Configurações e rotinas financeiras sensíveis
    match /commissionConfigs/{unitId} {
      allow read, write: if canManageFinance() && isUserInUnit(unitId);
    }

    match /dataImportJobs/{jobId} {
      allow read, write: if canManageFinance();
    }

    match /reconciliation_reports/{reportId} {
      allow read, write: if canManageFinance();
    }

    match /reports_manual_weeks/{reportId} {
      allow read, write: if canManageFinance();
    }

    // Planejamento, produção e métricas de marketing
    match /marketing_campaigns/{documentId} {
      allow read, write: if canManageMarketing();
    }

    match /marketing_traffic/{documentId} {
      allow read, write: if canManageMarketing();
    }

    match /marketing_organic/{documentId} {
      allow read, write: if canManageMarketing();
    }

    match /social_posts/{documentId} {
      allow read, write: if canManageMarketing();
    }

    match /social_library/{documentId} {
      allow read, write: if canManageMarketing();
    }

    // Mensagens: marketing e recepção operam; demais perfis não acessam as listas.
    match /message_contact_lists/{documentId} {
      allow read, write: if canManageCommunication();
    }

    match /message_dispatch_history/{documentId} {
      allow read, write: if canManageCommunication();
    }

    match /dispatch_audit/{documentId} {
      allow read, create: if canManageCommunication();
      allow update, delete: if false;
    }

    // Links inteligentes são públicos somente para resolução. A administração e
    // os dados analíticos continuam restritos aos perfis de comunicação.
    match /smart_links/{linkId} {
      allow read: if true;
      allow create, delete: if canManageCommunication();
      allow update: if canManageCommunication() || (
        !isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalClicks', 'lastClickAt']) &&
        request.resource.data.totalClicks == resource.data.totalClicks + 1
      );
    }

    match /smart_link_clicks/{clickId} {
      allow read: if canManageCommunication();
      allow create: if canManageCommunication() || (
        !isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'linkId', 'shortCode', 'destinationUrl', 'phase', 'cycleNumber',
          'timestamp', 'device', 'referrer', 'simulated'
        ]) &&
        request.resource.data.simulated == false
      );
      allow update, delete: if false;
    }

    // Logs de auditoria são imutáveis pelo cliente. A gravação deve ocorrer no
    // backend com Admin SDK, enquanto administradores mantêm acesso de leitura.
    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Defesa em profundidade: qualquer coleção não inventariada permanece negada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
