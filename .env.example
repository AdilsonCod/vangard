# Bancos reais não devem receber dados padrão automaticamente.
VITE_ENABLE_DATABASE_SEED=false

# Inteligência artificial do sistema (somente no servidor).
DEEPSEEK_API_KEY=sua-chave-deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
# Opcional: altere apenas para proxy ou endpoint compatível.
DEEPSEEK_API_URL=https://api.deepseek.com

# Firebase Admin SDK (somente no servidor; use uma das duas opções).
FIREBASE_PROJECT_ID=vansmanagement-6ab54
# Produção/Vercel: JSON completo da conta de serviço armazenado como segredo.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Desenvolvimento local: caminho absoluto para o JSON fora do repositório.
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho-seguro\firebase-admin.json

# Diretório persistente da sessão do WhatsApp no servidor.
WHATSAPP_AUTH_DIR=.whatsapp-session
