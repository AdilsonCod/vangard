# Bancos reais não devem receber dados padrão automaticamente.
VITE_ENABLE_DATABASE_SEED=false

# Inteligência artificial do sistema (somente no servidor).
DEEPSEEK_API_KEY=sua-chave-deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
# Opcional: altere apenas para proxy ou endpoint compatível.
DEEPSEEK_API_URL=https://api.deepseek.com

# Firebase Admin SDK (somente no servidor; use uma das duas opções).
FIREBASE_PROJECT_ID=vansmanagement-6ab54
# Produção/Vercel: JSON completo da conta de serviço armazenado como segredo.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Desenvolvimento local: caminho absoluto para o JSON fora do repositório.
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho-seguro\firebase-admin.json

# URL pública do serviço persistente usada pelo frontend (variável de build).
VITE_MESSAGE_SERVICE_URL=http://localhost:3001

# Serviço persistente do WhatsApp. Use um volume durável para /data em produção.
MESSAGE_SERVICE_PORT=3001
MESSAGE_ALLOWED_ORIGINS=http://localhost:3000,https://seu-dominio.vercel.app
MESSAGE_AUTO_CONNECT=true
WHATSAPP_AUTH_VAULT=data/whatsapp/session.enc
# Segredo exclusivo, aleatório e com no mínimo 32 caracteres. Nunca use VITE_ neste nome.
MESSAGE_AUTH_ENCRYPTION_KEY=gere-um-segredo-aleatorio-com-32-ou-mais-caracteres
